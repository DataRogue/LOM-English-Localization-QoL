  // ---------------------------------------------------------------------------
  // CharacterIntroPanel (first-meeting card). Text is typed in one char per frame,
  // so XUnity's AutoResize re-runs on every character: onTextChange on all three.
  // ---------------------------------------------------------------------------
  {
    "id": "charintro-title",
    "comment": "Relationship title above the name: design 40px, XUnity AutoResize(12,20) shrank it to a 20px caption. Fixed 30px single line (longest title ~38 chars = ~430px, box 520 stays inside the frame, ends 1519 < 1636), no best-fit.",
    "paths": ["**/CharacterIntroPanel/Frame/Title"],
    "onTextChange": true,
    "rect": { "width": 520, "height": 40, "dy": 4 },
    "text": { "bestFit": false, "fontSize": 30, "alignment": "MiddleLeft", "hOverflow": "Overflow", "vOverflow": "Overflow" }
  },
  {
    "id": "charintro-name",
    "comment": "Name on the ink brush (TMP, 400x60, auto 24-42). Widen to 520 so a long English name ('Fire Dragon Immortal Monarch') needs less auto-shrink; still left-aligned on the brush. (The DFT_S5_SDF_StoryTitle_002 atlas has no Latin glyphs and falls back to a jagged bitmap sans; a tmp.font swap to Palatino was tried but TMP_FontAsset.CreateFontAsset(Font) returns null for OS fonts in this build, so the original font is kept.)",
    "paths": ["**/CharacterIntroPanel/Frame/Name"],
    "onTextChange": true,
    "rect": { "width": 520, "height": 60 },
    "tmp": { "autoSize": true, "minSize": 26, "maxSize": 42, "wordWrap": false, "overflow": "Overflow" }
  },
  {
    "id": "charintro-intro",
    "comment": "Intro paragraph (560 wide, paper's inner bottom border ~y840). Unity best-fit is unreliable here: with bf 16-21 it settled at ~15px with 13 lines in a 290 box and Truncate dropped the last line (reviewer regression); the untouched game (bf 8-18) rendered ~14px. So: FIXED 16px, no best-fit, the game's own 0.9 line spacing (Source Han Serif pitch ~1.43em -> ~20.6px/line), box 290 tall (548-838) and vOverflow Overflow so a line can never be lost. Measured: ~64 chars/line at 16px. Worst real string (CharacterIntro0/special405, 570 chars) = ~10 lines / 206px; the 832-char machine-translated placeholder shown by the capture harness = 14 lines / 288px, still inside the paper. onTextChange because the resizer files re-apply AutoResize(8,18) on every translated text set and the game types the string in one char per frame. The prefab's ContentSizeFitter (vertical PreferredSize) is switched to Unconstrained, or it would regrow the box to the text's preferred height and undo the 290.",
    "paths": ["**/CharacterIntroPanel/Frame/Intro"],
    "onTextChange": true,
    "rect": { "height": 290 },
    "fitter": { "vertical": "Unconstrained" },
    "text": { "bestFit": false, "fontSize": 16, "lineSpacing": 0.9, "alignment": "UpperLeft", "hOverflow": "Wrap", "vOverflow": "Overflow" }
  },
  {
    "id": "social-description-clear-of-tabs",
    "comment": "The 'Relationships' tab label runs to x=492 while the biography block started at x=472, so the bio text ran across the label. Shift the description group 45px right (it ended at x=896 with room to spare).",
    "path": "**/StatusPanel/Container/Panels/Social/Description",
    "rect": { "dx": 45 }
  }
