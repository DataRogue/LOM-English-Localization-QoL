  // ---------------------------------------------------------------------------
  // Say dialogs (/StoryCore/SayDialogs/*) - not capturable through screens.json,
  // judged from the inventory + the --all dump. Only the name plate needs work:
  // StoryText is already 1050x200 horizontal with the resizer's 10-24 best fit.
  // ---------------------------------------------------------------------------
  {
   "id": "say-name-plate",
   "comment": "Speaker name (350x97 TMP, TopRight, overflow), right edge at x554 above the story text; the dialog art starts at x192. Auto-size keeps long localized names inside the plate instead of overflowing left over the art. onTextChange because the name is assigned after enable (SetCharacterName) and the resizer's ChangeFontSizeByPercentage(0.7) re-applies on that assignment. No font swap (the box's DFT_S5_SDF_StoryTitle_001 is a dynamic atlas; a 'Palatino Linotype' TMP asset cannot be built by TMP 3.0 and the failed build was retried on every line). Floor 20 rather than 24: of the 341 named speakers in character/think dialogs, 'Fire Dragon Immortal Monarch' (special204, 91 lines) is the only one wider than 350px at 24 with Source Han Serif metrics (389px, reaching x164); at 20 it settles at ~21.6px inside the plate. With the 0.5em-per-letter advances TMP reports for this atlas in the live dumps it already fits at 25px, and every other name stays >= 24.4px, so the lower floor changes nothing else.",
   "paths": [
    "/StoryCore/SayDialogs/CharacterSayDialog/Panel/Name/Text (TMP)",
    "/StoryCore/SayDialogs/ThinkSayDialog/Panel/Name/Text (TMP)"
   ],
   "onTextChange": true,
   "tmp": {
    "autoSize": true,
    "minSize": 20,
    "maxSize": 42,
    "wordWrap": false,
    "overflow": "Overflow",
    "alignment": "TopRight"
   }
  },
