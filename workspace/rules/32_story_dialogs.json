    "/StoryCore/MenuDialogs/OptionMenuDialog/ButtonGroup/OptionButton*/*/Text"
   ],
   "onTextChange": true,
   "text": {
    "bestFit": true,
    "minSize": 16,
    "maxSize": 22
   }
