[
  // ---------------------------------------------------------------------------
  // Army battle (Battle.unity = level5) follow-ups to 51_army_battle.json and
  // 60_offline_panels.json. Written offline from the level5 / sharedassets5
  // dumps (UnityPy) and MortalBattle.dll; see each comment for the numbers.
  // ---------------------------------------------------------------------------
  {
    "id": "army-ready-tooltips",
    "comment": "Key-hint columns on the pre-battle card (ReadyPanel/Container/Info/Tootip/Text (1..3): 200x127, 200x168 and 163x168 UpperLeft boxes at 25px, Wrap/Truncate, no best fit). Same three System/BattleInfoText_0N strings as the pause menu's Info/Tootip, which 60_offline_panels.json:pause-info-tooltips already fits, but that rule only matches **/PausePanel/Info/Tootip/Text (*), so the ReadyPanel copy stayed on the prefab settings: 'Direct Fire - [X]', 'Projectile - [Hold X]' and 'Verbal Attack - [C]' each wrap in the 200px column and BattleInfoText_02 needs 7 lines = 219px in the 168px box, losing 'Verbal Attack - [C]'; 'Move - [Arrow Keys]' wraps in Text (1) too. Best fit 16..25 settles Text (2) at about 20px with every hint on one line (5 lines = 125px) and leaves the short Text (3) at 25.",
    "paths": [
      "/[UI]/MainUI/Level_3/ReadyPanel/Container/Info/Tootip/Text (*)"
    ],
    "onTextChange": true,
    "text": { "bestFit": true, "minSize": 16, "maxSize": 25, "hOverflow": "Wrap", "vOverflow": "Truncate", "alignment": "UpperLeft" }
  },
  {
    "id": "army-outside-dialogue",
    "comment": "Off-screen thrower's shout (sharedassets5 prefab LeftOutsideDialogue, cloned by WeaponSpawner.ShowDialogue at the map edge as 'LeftOutsideDialogue(Clone)' and filled through OutsideDialogue.SetText, so the Text.text hook sees it). The Text is a stretch-anchored 0x0 box inside the 250x150 world-space panel (scale 0.01), 50px UpperCenter, Wrap/Truncate, no best fit, no background image. The three serialized lines (你他媽的! / 你死定了! / 納命來!) are one 4-5 glyph line in Chinese; XUnity's English ('Come and meet your end!' ~600px at 50) wraps to three 62px lines = 187px in the 150px box and loses the last one. Best fit 22..50 keeps it inside the box (three lines fit at 40, two at 36 or less) and MiddleCenter keeps the short lines where the original single line sat.",
    "paths": [
      "**/*OutsideDialogue*/Text"
    ],
    "onTextChange": true,
    "text": { "bestFit": true, "minSize": 22, "maxSize": 50, "hOverflow": "Wrap", "vOverflow": "Truncate", "alignment": "MiddleCenter" }
  }
]
